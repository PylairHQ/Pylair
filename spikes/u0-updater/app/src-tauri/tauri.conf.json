{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "u0-updater-spike",
  "version": "0.1.0",
  "identifier": "dev.pylair.u0",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "u0-updater-spike", "width": 480, "height": 320 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend": "backend/",
      "../python": "python/"
    },
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://127.0.0.1:8377/latest.json"],
      "pubkey": "__PUBKEY__"
    }
  }
}
