{
  "name": "create-pylair",
  "version": "0.1.0-rc.15",
  "description": "Scaffold a new Pylair project (npx create-pylair my-app)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PylairHQ/Pylair.git",
    "directory": "packages/create-pylair"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-pylair": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm build",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
