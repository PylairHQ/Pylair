{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__APP_NAME__",
  "version": "0.1.0",
  "identifier": "__APP_ID__",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "__APP_NAME__",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' blob: ipc: http://ipc.localhost pylair-blob: http://pylair-blob.localhost; img-src 'self' data: blob: pylair-blob: http://pylair-blob.localhost; media-src 'self' blob: pylair-blob: http://pylair-blob.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python": "python/",
      "resources/site-packages": "site-packages/",
      "resources/app": "app/",
      "resources/pylair-wrap.json": "pylair-wrap.json",
      "resources/THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES/"
    },
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
